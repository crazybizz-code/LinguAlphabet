# Public — safe to expose to the browser (Next.js NEXT_PUBLIC_ convention)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The production domain (no trailing slash) — used for metadataBase,
# robots.txt and sitemap.xml. Falls back to http://localhost:3000 if unset,
# but must be set to the real domain before deploying.
NEXT_PUBLIC_SITE_URL=

# Microsoft Clarity project ID — only loaded when NODE_ENV=production
# (src/app/layout.tsx). Optional locally.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Server-only secret — never prefix with NEXT_PUBLIC_, this must not reach the browser bundle
GEMINI_API_KEY=

# Optional — milliseconds to wait between SUCCESSFUL enrichment calls during
# content ingestion (src/lib/content-engine/pipeline.ts). Defaults to 1500.
# The pipeline is sequential, so without pacing a run fires ~18 Gemini
# requests back to back and walks into the per-minute quota, which is what
# produced 429s across every source. Raise this if 429s persist; lower it if
# a run approaches the ingest route's 300s maxDuration. Deliberately does NOT
# affect interactive word lookup, which must stay fast.
AI_ENRICHMENT_PACING_MS=

# Server-only secret — Tuto's AI Coach provider (src/ai/providers/openrouter).
# Never NEXT_PUBLIC_, never import from a Client Component.
OPENROUTER_API_KEY=

# OpenRouter model slug Tuto talks to — never hardcoded in code, read
# fresh on every request (src/ai/providers/openrouter/client.ts).
#
# CLOSED BETA VALUE: google/gemini-2.5-flash
# Switched from the previous GPT-5.5-class model for cost. Changing this
# is a config change, not a deploy. Anything set here must also exist in
# src/ai/telemetry/pricing.ts or estimated_cost_usd records as NULL.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional — selects which registered provider powers Tuto
# (src/ai/providers/registry.ts). Defaults to "openrouter" if unset.
AI_PROVIDER=

# ---- Tool-result token budgets (src/ai/services/token-budget.ts) ----
# Optional. Cap how many tokens a tool result may occupy, so an oversized
# article or transcript is never re-sent in full on every tool-loop
# iteration. Defaults are sized so a typical full article passes through
# untouched; only outliers are trimmed, and trimming is always disclosed
# to the model. Lower these to cut cost further, at some risk to answer
# quality on very long documents.
AI_TOOL_RESULT_TOKEN_BUDGET=
AI_TOOL_LOOP_TOKEN_BUDGET=

# ---- AI usage telemetry (src/ai/telemetry) ----
# Optional price overrides for the estimated-cost column, so a provider
# price change is a config edit rather than a deploy.
# Format: "slug:inputPerMillion,outputPerMillion;slug:in,out"
# e.g. "google/gemini-2.5-flash:0.3,2.5"
# Prices in src/ai/telemetry/pricing.ts are a SNAPSHOT — verify against
# https://openrouter.ai/models before trusting an absolute figure.
AI_MODEL_PRICING=

# Server-only secret, bypasses Row Level Security — Content Engine ingestion
# only (src/lib/supabase/service-client.ts). Never commit, never NEXT_PUBLIC_,
# never import from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret — verifies that /api/content-engine/ingest requests
# actually come from Vercel Cron (vercel.json), not an open endpoint.
# Vercel auto-injects it as "Authorization: Bearer $CRON_SECRET". Optional
# locally; required in production once the cron is enabled. Also guards
# /api/push/send-streak-reminders (same mechanism, same env var).
CRON_SECRET=

# Web Push VAPID key pair (Execution Sprint P2 — streak re-engagement).
# Generate with `npx web-push generate-vapid-keys`. The public key is safe
# in the browser (NEXT_PUBLIC_); the private key is a real secret — never
# commit it, never NEXT_PUBLIC_. Without both set, push subscribe/send
# routes no-op rather than error (see src/lib/push/vapid.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address required by the Web Push protocol (RFC 8030) — shown to
# push services, not learners. A real mailto: or https: URL.
VAPID_SUBJECT=

# Server-only — comma-separated emails allowed to view /insights (Product
# Intelligence Sprint). There's no role/permission system in LinguABC yet,
# so this is a deliberately minimal allowlist rather than a fabricated
# "admin" flag on profiles — see src/app/insights/page.tsx. Unset means
# nobody can view the dashboard (fails closed, not open).
ADMIN_EMAILS=

# Server-only secret — operator-only draft podcast preview
# (src/app/podcast-preview/[id]/page.tsx). Submitted via POST body (never
# a URL parameter), exchanged for an HttpOnly cookie scoped to /podcast-preview.
# Unset means nobody can access the preview (fails closed). The LinguABC user
# must also be authenticated — the cookie alone is not sufficient.
PREVIEW_SECRET=

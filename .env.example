# Public — safe to expose to the browser (Next.js NEXT_PUBLIC_ convention)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The production domain (no trailing slash) — used for metadataBase,
# robots.txt and sitemap.xml. Falls back to http://localhost:3000 if unset,
# but must be set to the real domain before deploying.
NEXT_PUBLIC_SITE_URL=

# Microsoft Clarity project ID — only loaded when NODE_ENV=production
# (src/app/layout.tsx). Optional locally.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Server-only secret — never prefix with NEXT_PUBLIC_, this must not reach the browser bundle
GEMINI_API_KEY=

# Server-only secret — Tuto's AI Coach provider (src/ai/providers/openrouter).
# Never NEXT_PUBLIC_, never import from a Client Component.
OPENROUTER_API_KEY=

# OpenRouter model slug Tuto talks to, e.g. "openai/gpt-5.5" — never
# hardcoded in code, read fresh on every request
# (src/ai/providers/openrouter/client.ts).
OPENROUTER_MODEL=

# Optional — selects which registered provider powers Tuto
# (src/ai/providers/registry.ts). Defaults to "openrouter" if unset.
AI_PROVIDER=

# Server-only secret, bypasses Row Level Security — Content Engine ingestion
# only (src/lib/supabase/service-client.ts). Never commit, never NEXT_PUBLIC_,
# never import from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret — verifies that /api/content-engine/ingest requests
# actually come from Vercel Cron (vercel.json), not an open endpoint.
# Vercel auto-injects it as "Authorization: Bearer $CRON_SECRET". Optional
# locally; required in production once the cron is enabled.
CRON_SECRET=

{
  "name": "podcat-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0",
    "import:bbc:new": "node scripts/import-new-bbc-lessons.mjs",
    "validate:bbc:new": "node scripts/validate-new-bbc-lessons.mjs",
    "align:bbc": "node scripts/align-bbc-transcripts.mjs",
    "publish:lesson": "node scripts/publish-remote-lesson.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:open": "npx cap open android",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "pdf-parse": "^2.4.5"
  }
}
